---
import BaseLayout from '../layouts/BaseLayout.astro';
import MangaCard from '../components/MangaCard.astro';
import ShelfHero from '../components/ShelfHero.astro';
import { getCatalog } from '../data/catalog';

const catalog = getCatalog();
const items = catalog.items;
---

<BaseLayout title="salty.manga">
  <ShelfHero items={items} />

  <main class="page-shell">
    <section class="shelf-section" id="shelf">
      {items.length > 0 ? (
        <div class="manga-grid">
          {items.map((item) => <MangaCard item={item} />)}
        </div>
      ) : (
        <p class="empty-state">No manga cards yet.</p>
      )}
    </section>
  </main>
</BaseLayout>
