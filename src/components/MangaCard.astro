---
import { Image } from 'astro:assets';
import type { CatalogItem } from '../data/catalog';
import { canOptimizeImage } from '../data/images';
import { getMangaPath } from '../data/urls';

interface Props {
  item: CatalogItem;
}

const { item } = Astro.props;

function normalizeText(value: string) {
  return value
    .toLowerCase()
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^\w\s-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function getReviewPreview(value: string, maxLength = 210) {
  if (value.length <= maxLength) {
    return value;
  }

  const trimmed = value.slice(0, maxLength).replace(/\s+\S*$/, '');
  return `${trimmed}...`;
}

const imageUrl = item.source.imageUrl ?? item.anilist?.coverImage ?? null;
const mangaPath = getMangaPath(item);
const tags = item.source.tags.slice(0, 4);
const hasActions = Boolean(item.bookshopUrl || item.review);
const reviewPreview = item.review ? getReviewPreview(item.review) : null;
const searchIndex = normalizeText(
  [item.title, item.lookupTitle, item.review, ...item.genres, ...item.source.tags, item.anilist?.status]
    .filter(Boolean)
    .join(' ')
);
const initialCharacter = normalizeText(item.title).charAt(0).toUpperCase();
const initialLetter = /^[A-Z]$/.test(initialCharacter) ? initialCharacter : '#';
const detailBits = [
  item.anilist?.status,
  item.anilist?.volumes ? `${item.anilist.volumes} vols` : null
].filter(Boolean);
---

<article class="manga-card" data-genres={item.genres.join('|')} data-search={searchIndex} data-initial={initialLetter}>
  {imageUrl && canOptimizeImage(imageUrl) && (
    <Image
      class="manga-card-cover"
      src={imageUrl}
      alt={`Cover for ${item.title}`}
      inferSize
      widths={[208, 416, 720]}
      sizes="(min-width: 760px) 13rem, 100vw"
      format="webp"
      loading="lazy"
      decoding="async"
    />
  )}
  {imageUrl && !canOptimizeImage(imageUrl) && (
    <img
      class="manga-card-cover"
      src={imageUrl}
      alt={`Cover for ${item.title}`}
      width="600"
      height="900"
      loading="lazy"
      decoding="async"
    />
  )}

  <div class="manga-card-copy">
    <div class="manga-card-header">
      <p class="manga-card-kicker">{item.lookupTitle ?? 'CSV match'}</p>
      <h2><a href={mangaPath}>{item.title}</a></h2>
      {detailBits.length > 0 && <p class="manga-card-meta">{detailBits.join(' · ')}</p>}
    </div>

    <div class="manga-card-description-wrap">
      <p class="manga-card-description" data-card-description>{item.description}</p>
      <button class="manga-card-toggle" type="button" data-card-toggle hidden aria-expanded="false">
        Read more
      </button>
    </div>

    {reviewPreview && (
      <aside class="manga-card-review" aria-label={`Julian's take on ${item.title}`}>
        <p class="manga-card-review-label">Julian's take</p>
        <p>{reviewPreview}</p>
      </aside>
    )}

    {tags.length > 0 && (
      <ul class="manga-card-tags" aria-label={`${item.title} tags`}>
        {tags.map((tag) => <li>#{tag}</li>)}
      </ul>
    )}

    {item.genres.length > 0 && (
      <p class="manga-card-genres">
        <span>Genres</span>
        {item.genres.join(' · ')}
      </p>
    )}

    {hasActions && (
      <div class="manga-card-actions">
        {item.review && (
          <a class="review-link" href={mangaPath}>
            Read the full take
          </a>
        )}
        {item.bookshopUrl && (
          <a class="buy-link" href={item.bookshopUrl} rel="noopener noreferrer" target="_blank">
            Buy on Bookshop
          </a>
        )}
      </div>
    )}
  </div>
</article>
